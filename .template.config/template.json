{
  "$schema": "http://json.schemastore.org/template",
  "author": "OLuai",
  "classifications": [
    "Aspire",
    "Web",
    "SPA",
    "React",
    "ASP.NET",
    "Clean Architecture"],
  "name": "Clean Architecture Solution (React + Aspire)",
  "description": "An opinionated Clean Architecture Solution Template: ASP.NET Core + .NET Aspire backend with an optional React 19 / TanStack / shadcn / Tailwind v4 / Vite / Orval dashboard and PostgreSQL.",
  "identity": "Clean.Architecture.Solution.CSharp",
  "groupIdentity": "Clean.Architecture.Solution",
  "shortName": "ca-sln",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "CleanArchitecture",
  "preferNameDirectory": true,
  "symbols": {
    "caPackageVersion": {
      "type": "generated",
      "generator": "constant",
      "replaces": "caPackageVersion",
      "parameters": {
        "value": "10.0.0-preview"
      }
    },
    "caRepositoryUrl": {
      "type": "generated",
      "generator": "constant",
      "replaces": "caRepositoryUrl",
      "parameters": {
        "value": "https://github.com/OLuai/CleanArchitecture"
      }
    },
    "ClientFramework": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "React",
          "description": "React 19 dashboard (Vite, TanStack, shadcn/ui, Tailwind v4, Orval) served by the API."
        },
        {
          "choice": "None",
          "description": "Web API only. Drops the SPA, its Aspire resource and the acceptance tests."
        }
      ],
      "defaultValue": "React",
      "description": "Whether to include the React dashboard or generate a Web API only."
    },
    "UseReact": {
      "type": "computed",
      "value": "(ClientFramework == \"React\")"
    },
    "UseApiOnly": {
      "type": "computed",
      "value": "(ClientFramework == \"None\")"
    },
    "UseAspire": { "type": "computed", "value": "true" },
    "UseAngular": { "type": "computed", "value": "false" },
    "UsePostgreSQL": { "type": "computed", "value": "true" },
    "UseSqlServer": { "type": "computed", "value": "false" },
    "UseSqlite": { "type": "computed", "value": "false" },
    "UseGithubActions": { "type": "computed", "value": "true" },
    "UseAzurePipelines": { "type": "computed", "value": "false" }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**/*",
        "templates/**/*",
        ".azure/**/*",
        ".azdo/**/*",
        ".github/**/*",
        ".git/**/*",
        ".vs/**/*",
        ".aspire/**/*",
        "artifacts/**/*",
        "**/bin/**",
        "**/obj/**",
        "**/node_modules/**",
        "src/Web/ClientApp/build/**",
        "src/Web/ClientApp/.tanstack/**",
        "src/Web/ClientApp/src/api/generated/**",
        "src/Web/ClientApp/src/routeTree.gen.ts",
        "src/Web/wwwroot/openapi/**",
        "**/*.user",
        "**/*.filelist",
        "*.nuspec",
        "README.md",
        "TEMPLATE_GUIDE.md"
      ],
      "rename": {
        "README-template.md": "README.md"
      },
      "modifiers": [
        {
          "condition": "(UseGithubActions)",
          "include": [
            ".github/**/*"
          ]
        },
        {
          "condition": "(UseApiOnly)",
          "exclude": [
            "src/Web/ClientApp/**",
            "tests/Web.AcceptanceTests/**",
            "deploy/Dockerfile.web"
          ],
          "rename": {
            "deploy/Dockerfile.web-apionly": "deploy/Dockerfile.web"
          }
        },
        {
          "condition": "(!UseApiOnly)",
          "exclude": [
            "deploy/Dockerfile.web-apionly"
          ]
        }
      ]
    }
  ]
}
