{
  "$schema": "http://json.schemastore.org/template",
  "author": "OLuai",
  "classifications": [
    "Aspire",
    "Web",
    "SPA",
    "React",
    "ASP.NET",
    "Clean Architecture"],
  "name": "Clean Architecture Solution (React + Aspire)",
  "description": "An opinionated Clean Architecture Solution Template: ASP.NET Core + .NET Aspire backend with a React 19 / TanStack / shadcn / Tailwind v4 / Vite / Orval single-page application and PostgreSQL.",
  "identity": "Clean.Architecture.Solution.CSharp",
  "groupIdentity": "Clean.Architecture.Solution",
  "shortName": "ca-sln",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "CleanArchitecture",
  "preferNameDirectory": true,
  "symbols": {
    "caPackageVersion": {
      "type": "generated",
      "generator": "constant",
      "replaces": "caPackageVersion",
      "parameters": {
        "value": "10.0.0-preview"
      }
    },
    "caRepositoryUrl": {
      "type": "generated",
      "generator": "constant",
      "replaces": "caRepositoryUrl",
      "parameters": {
        "value": "https://github.com/OLuai/CleanArchitecture"
      }
    },
    "UseApiOnly": { "type": "computed", "value": "false" },
    "UseAspire": { "type": "computed", "value": "true" },
    "UseReact": { "type": "computed", "value": "true" },
    "UseAngular": { "type": "computed", "value": "false" },
    "UsePostgreSQL": { "type": "computed", "value": "true" },
    "UseSqlServer": { "type": "computed", "value": "false" },
    "UseSqlite": { "type": "computed", "value": "false" },
    "UseGithubActions": { "type": "computed", "value": "true" },
    "UseAzurePipelines": { "type": "computed", "value": "false" }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**/*",
        "templates/**/*",
        ".azure/**/*",
        ".azdo/**/*",
        ".github/**/*",
        ".git/**/*",
        ".vs/**/*",
        ".aspire/**/*",
        "artifacts/**/*",
        "**/bin/**",
        "**/obj/**",
        "**/node_modules/**",
        "src/Web/ClientApp/build/**",
        "src/Web/ClientApp/.tanstack/**",
        "src/Web/ClientApp/src/api/generated/**",
        "src/Web/ClientApp/src/routeTree.gen.ts",
        "src/Web/wwwroot/openapi/**",
        "**/*.user",
        "**/*.filelist",
        "*.nuspec",
        "README.md",
        "TEMPLATE_GUIDE.md"
      ],
      "rename": {
        "README-template.md": "README.md"
      },
      "modifiers": [
        {
          "condition": "(UseGithubActions)",
          "include": [
            ".github/**/*"
          ]
        }
      ]
    }
  ]
}
