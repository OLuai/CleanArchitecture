{
  "$schema": "http://json.schemastore.org/template",
  "author": "OLuai",
  "classifications": [
    "Aspire",
    "Web",
    "SPA",
    "React",
    "ASP.NET",
    "Clean Architecture"],
  "name": "Clean Architecture Solution (Aspire, optional React)",
  "description": "An opinionated Clean Architecture Solution Template: ASP.NET Core + .NET Aspire backend with PostgreSQL, and an optional React 19 / TanStack / shadcn / Tailwind v4 / Vite / Orval dashboard (--client-framework None for a Web API only).",
  "identity": "Clean.Architecture.Solution.CSharp",
  "groupIdentity": "Clean.Architecture.Solution",
  "shortName": "ca-sln",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "CleanArchitecture",
  "preferNameDirectory": true,
  "symbols": {
    "caPackageVersion": {
      "type": "generated",
      "generator": "constant",
      "replaces": "caPackageVersion",
      "parameters": {
        "value": "10.0.0-preview"
      }
    },
    "caRepositoryUrl": {
      "type": "generated",
      "generator": "constant",
      "replaces": "caRepositoryUrl",
      "parameters": {
        "value": "https://github.com/OLuai/CleanArchitecture"
      }
    },
    "ClientFramework": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "React", "description": "React dashboard served by the Web project" },
        { "choice": "None", "description": "Web API only" }
      ],
      "defaultValue": "React",
      "description": "The client to generate: React, or None for a Web API only."
    },
    "UseApiOnly": { "type": "computed", "value": "(ClientFramework == \"None\")" },
    "UseAspire": { "type": "computed", "value": "true" },
    "UseReact": { "type": "computed", "value": "(ClientFramework == \"React\")" },
    "UseAngular": { "type": "computed", "value": "false" },
    "UsePostgreSQL": { "type": "computed", "value": "true" },
    "UseSqlServer": { "type": "computed", "value": "false" },
    "UseSqlite": { "type": "computed", "value": "false" },
    "UseGithubActions": { "type": "computed", "value": "true" },
    "UseAzurePipelines": { "type": "computed", "value": "false" }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**/*",
        "templates/**/*",
        ".azure/**/*",
        ".azdo/**/*",
        ".github/**/*",
        ".git/**/*",
        ".vs/**/*",
        ".aspire/**/*",
        "artifacts/**/*",
        "**/bin/**",
        "**/obj/**",
        "**/node_modules/**",
        "src/Web/ClientApp/build/**",
        "src/Web/ClientApp/.tanstack/**",
        "src/Web/ClientApp/src/api/generated/**",
        "src/Web/ClientApp/src/routeTree.gen.ts",
        "src/Web/wwwroot/openapi/**",
        "**/*.user",
        "**/*.filelist",
        "*.nuspec",
        "README.md",
        "TEMPLATE_GUIDE.md"
      ],
      "rename": {
        "README-template.md": "README.md"
      },
      "modifiers": [
        {
          "condition": "(UseGithubActions)",
          "include": [
            ".github/**/*"
          ]
        },
        {
          "condition": "(UseApiOnly)",
          "exclude": [
            "src/Web/ClientApp/**/*",
            ".claude/launch.json",
            "tests/Web.AcceptanceTests/**/*"
          ],
          "rename": {
            ".claude/launch.api-only.json": ".claude/launch.json"
          }
        },
        {
          "condition": "(!UseApiOnly)",
          "exclude": [
            ".claude/launch.api-only.json"
          ]
        },
        {
          "condition": "true",
          "exclude": [
            ".github/FUNDING.yml",
            ".github/icon.png",
            ".github/ISSUE_TEMPLATE/**/*",
            ".github/workflows/jekyll-gh-pages.yml",
            ".github/workflows/package.yml",
            ".github/workflows/release.yml",
            ".github/workflows/test-templates.yml",
            "build/repack.ps1",
            "build/test.ps1"
          ]
        }
      ]
    }
  ]
}
