# syntax=docker/dockerfile:1.7
# Runs EF Core migrations and the seeder, then exits. Compose gates the web service on its
# successful completion.
ARG DOTNET_VERSION=10.0

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
WORKDIR /src

COPY global.json Directory.Build.props Directory.Packages.props CleanArchitecture.slnx ./
COPY src/ ./src/

RUN dotnet restore ./src/Migration/Migration.csproj
RUN dotnet publish ./src/Migration/Migration.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION} AS runtime
WORKDIR /app
COPY --from=build /app/publish ./

ENV DOTNET_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true

ENTRYPOINT ["dotnet", "CleanArchitecture.Migration.dll"]
