# Copy to .env (or .env.prod) on the host - DO NOT COMMIT.
# This file is the contract between the compose stack and the application's configuration:
# every key here maps to an ASP.NET configuration path, with __ standing for a section separator.

# Stack identity. Prefixes container, volume and Traefik router names, so several environments
# can share one host.
STACK_NAME=cleanarchitecture-staging
# Maps to ASPNETCORE_ENVIRONMENT / DOTNET_ENVIRONMENT: Staging or Production.
# Development runs the DevelopmentSeeder and its test accounts with known passwords: only for a
# pre-production that testers you trust walk through.
DOTNET_ENVIRONMENT=Staging

# Registry and images. IMAGE_TAG is overwritten by CI with the commit SHA.
# Deploy-Preprod.ps1 (docker load, no registry) forces its own values (local/cleanarchitecture/...)
# over these three lines: they only matter for a deployment from a registry.
REGISTRY=ghcr.io
IMAGE_NAMESPACE=<your-org-or-user>/cleanarchitecture
IMAGE_TAG=latest

# Public DNS name. Behind Traefik it must already point at this host for the ACME TLS challenge
# to succeed; behind a Cloudflare Tunnel (docker-compose.cloudflared.yml) it is the public
# hostname configured on the tunnel, and only documents the stack.
PUBLIC_HOST=staging.example.com

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > the tunnel > Install connector),
# only with docker-compose.cloudflared.yml. A secret: it can route traffic into the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL. The compose file assembles these into
# ConnectionStrings__CleanArchitectureDb for both the migration job and the web app.
POSTGRES_DB=CleanArchitectureDb
POSTGRES_USER=cleanarchitecture
POSTGRES_PASSWORD=

# Mail relay (Smtp__*). All optional: without a host the stack runs and says so on
# /admin/email, where an administrator can also enter these. SMTP_SECURITY is StartTls
# (default), Tls or None.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=CleanArchitecture
