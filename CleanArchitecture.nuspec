<?xml version="1.0" encoding="utf-8"?>
<!-- Packed by build/Template.csproj (dotnet pack), which supplies $version$: see build/repack.ps1
     for a local install and .github/workflows/release.yml for GitHub Packages. -->
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>

    <id>OLuai.CleanArchitecture.Template</id>
    <version>$version$</version>
    <title>Clean Architecture Solution Template (OLuai)</title>
    <authors>OLuai</authors>
    <description>Opinionated Clean Architecture solution template for .NET 10: Aspire, PostgreSQL, permissions, email, and an optional React dashboard (--client-framework None for a Web API only).</description>
    <summary>
      Personal fork of jasontaylordev/CleanArchitecture. dotnet new ca-sln creates the solution; dotnet new ca-usecase scaffolds a command or query.
    </summary>
    <releaseNotes></releaseNotes>

    <projectUrl>https://github.com/OLuai/CleanArchitecture</projectUrl>
    <repository type="git" url="https://github.com/OLuai/CleanArchitecture.git" />

    <license type="expression">MIT</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>clean-architecture project template csharp dotnet react aspire postgresql</tags>
    <icon>icon.png</icon>
    <readme>README.md</readme>

    <packageTypes>
      <packageType name="Template" />
    </packageTypes>

  </metadata>

  <files>
    <file src=".template.config\icon.png" />
    <file src="README.md" />
    <!-- Template sources only: dependencies, build output and generated client code are recreated
         by the generated solution. Everything else is filtered at instantiation by template.json. -->
    <file src=".\**" target="content" exclude="**\node_modules\**;**\bin\**;**\obj\**;.\artifacts\**;.\.git\**;.\.vs\**;.\.vscode\**;**\ClientApp\build\**;**\ClientApp\.tanstack\**;**\ClientApp\src\api\generated\**;**\wwwroot\openapi\**;**\*.user;.\build\Template.csproj;.\CleanArchitecture.nuspec" />
  </files>

</package>
